---
const base    = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const heroUrl = `${base}assets/plc-hero-metal.jpg`;
---

<!--
  Desktop: full-screen section, h1 + keywords + scroll cue at bottom, centered.
  Mobile:  260px image block + separate text block below with the h1.
-->

<section
  class="splash"
  aria-label="Hero"
  style={`--hero-url: url('${heroUrl}')`}
>
  <p class="eyebrow desktop-only">Impermeabilizzazioni · <b>Roma &amp; Lazio</b></p>

  <div class="splash-foot desktop-only">
    <div class="keywords" aria-label="Servizi principali">
      <span>Impermeabilizzare</span>
      <span class="d">◆</span>
      <span>Ristrutturare</span>
      <span class="d">◆</span>
      <span>Garantire</span>
    </div>
    <div class="scrollcue" aria-hidden="true">
      <span>Scorri</span>
      <span class="ar">↓</span>
    </div>
  </div>
</section>

<!-- Mobile-only: hero text lives BELOW the image, not overlaid -->
<div class="hero-mobile" aria-label="Hero text">
  <p class="mob-eye">Impermeabilizzazioni · <b>Roma &amp; Lazio</b></p>
  <h1 class="mob-h1">Terrazzi a prova<br>d'acqua.</h1>
  <div class="mob-btns">
    <a class="mob-btn-primary" href="#contatti">Prenota un sopralluogo</a>
    <a class="mob-btn-ghost" href="#servizi">Scopri i lavori →</a>
  </div>
</div>

<style>
  .splash {
    position: relative;
    min-height: 91vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    overflow: hidden;
    padding: 64px 28px 44px;
    background: #0c0c0f var(--hero-url) center center / cover no-repeat;
  }
  .splash::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10,10,12,.7)  0%,
      rgba(10,10,12,0)   22%,
      rgba(10,10,12,0)   44%,
      rgba(10,10,12,.65) 72%,
      var(--bg)          100%
    );
    pointer-events: none;
    z-index: 0;
  }
  .splash > * { position: relative; z-index: 1; }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(255,255,255,.82);
  }
  .eyebrow b { color: var(--orange-bright); font-weight: 400; }

  /* Vertically-stacked bottom block, centered */
  .splash-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .splash-h1 {
    color: #fff;
    font-size: 58px;
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1;
    margin: 0;
    text-shadow: 0 2px 40px rgba(0,0,0,.45);
  }

  .keywords {
    display: flex;
    gap: clamp(10px, 2vw, 22px);
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: clamp(12px, 1.5vw, 17px);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255,255,255,.82);
  }
  .keywords .d { color: var(--orange-bright); font-size: .7em; }

  .scrollcue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,.6);
  }
  .scrollcue .ar { font-size: 15px; animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) { .scrollcue .ar { animation: none; } }

  /* ── Mobile hero text block (hidden on desktop) ── */
  .hero-mobile {
    display: none;
    flex-direction: column;
    gap: 12px;
    padding: 20px 18px 22px;
    background: var(--bg);
    border-bottom: 1.5px solid var(--line-soft);
  }
  .mob-eye {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .mob-eye b { color: var(--orange-bright); font-weight: 400; }
  .mob-h1 {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 34px;
    line-height: 1.02;
    letter-spacing: -0.6px;
    color: var(--ink);
    margin: 0;
  }
  .mob-btns { display: flex; flex-direction: column; gap: 9px; }
  .mob-btn-primary {
    display: block;
    width: 100%;
    padding: 15px;
    background: var(--orange);
    color: #160d04;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: .2px;
    border-radius: 8px;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(219,98,2,.35);
    transition: background .15s, box-shadow .15s;
  }
  .mob-btn-primary:active { background: var(--orange-deep); box-shadow: none; }
  .mob-btn-ghost {
    display: block;
    width: 100%;
    padding: 13px;
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    text-align: center;
    text-decoration: none;
    transition: border-color .15s, color .15s;
  }
  .mob-btn-ghost:active { border-color: var(--ink-soft); color: var(--ink); }

  /* ── Responsive ── */
  @media (max-width: 880px) {
    .splash {
      min-height: 280px;
      height: 280px;
      padding: 18px 20px 0;
      background-size: 130%;
      justify-content: flex-start;
      align-items: flex-start;
    }
    .splash::before {
      background: linear-gradient(
        180deg,
        transparent       0%,
        transparent       55%,
        rgba(10,10,12,.6) 78%,
        var(--bg)         100%
      );
    }
    .desktop-only { display: none !important; }
    .hero-mobile  { display: flex; }
  }
</style>
