---
const base    = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const heroUrl = `${base}assets/plc-hero-metal.jpg`;
---

<!--
  Desktop: full-screen section, text overlaid at bottom.
  Mobile:  260px image block (contain) + separate text block below.
-->

<section
  class="splash"
  aria-label="Hero"
  style={`--hero-url: url('${heroUrl}')`}
>
  <!-- desktop-only content inside the image -->
  <p class="eyebrow desktop-only">Impermeabilizzazioni · <b>Roma &amp; Lazio</b></p>
  <div class="splash-foot desktop-only">
    <div class="keywords">
      <span>Impermeabilizzare</span>
      <span class="d">◆</span>
      <span>Ristrutturare</span>
      <span class="d">◆</span>
      <span>Garantire</span>
    </div>
    <div class="scrollcue" aria-hidden="true">
      <span>Scorri</span>
      <span class="ar">↓</span>
    </div>
  </div>
</section>

<!-- Mobile-only: hero text lives BELOW the image, not overlaid -->
<div class="hero-mobile" aria-label="Hero text">
  <p class="mob-eye">Impermeabilizzazioni · <b>Roma &amp; Lazio</b></p>
  <div class="mob-kw">
    <span>Impermeabilizzare</span>
    <span class="d">◆</span>
    <span>Ristrutturare</span>
    <span class="d">◆</span>
    <span>Garantire</span>
  </div>
  <h1 class="mob-h1">Terrazzi a prova<br>d'acqua.</h1>
  <div class="mob-btns">
    <a class="btn-base btn-cta mob-btn" href="#contatti">Prenota un sopralluogo</a>
    <a class="btn-base btn-ghost mob-btn" href="#servizi">Scopri i lavori →</a>
  </div>
</div>

<style>
  /* ── Shared splash image ── */
  .splash {
    position: relative;
    min-height: 91vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    overflow: hidden;
    padding: 64px 28px 44px;
    background: #0c0c0f var(--hero-url) center center / cover no-repeat;
  }
  .splash::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10,10,12,.7)  0%,
      rgba(10,10,12,0)  22%,
      rgba(10,10,12,0)  44%,
      rgba(10,10,12,.58) 72%,
      var(--bg)          98%
    );
    pointer-events: none;
    z-index: 0;
  }
  .splash > * { position: relative; z-index: 1; }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(255,255,255,.82);
  }
  .eyebrow b { color: var(--orange-bright); font-weight: 400; }

  .splash-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .keywords {
    display: flex;
    gap: clamp(10px, 2vw, 22px);
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: clamp(12px, 1.5vw, 17px);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255,255,255,.82);
  }
  .keywords .d { color: var(--orange-bright); font-size: .7em; }

  .scrollcue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,.6);
  }
  .scrollcue .ar { font-size: 15px; animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) { .scrollcue .ar { animation: none; } }

  /* ── Mobile hero text block (hidden on desktop) ── */
  .hero-mobile {
    display: none;
    flex-direction: column;
    gap: 14px;
    padding: 22px 18px 24px;
    background: var(--bg);
  }
  .mob-eye {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .mob-eye b { color: var(--orange-bright); font-weight: 400; }
  .mob-kw {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--ink);
  }
  .mob-kw .d { color: var(--orange-bright); font-size: .8em; }
  .mob-h1 {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 34px;
    line-height: 1.04;
    letter-spacing: -.5px;
    color: var(--ink);
    margin: 0;
  }
  :global(body.char-industriale) .mob-h1 {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: .5px;
    font-weight: 600;
  }
  .mob-btns { display: flex; flex-direction: column; gap: 10px; }
  .mob-btn  { justify-content: center; font-size: 16px; padding: 14px 19px; }

  /* ── Responsive ── */
  @media (max-width: 880px) {
    /* Image: show full logo with contain, short height, fade at bottom */
    .splash {
      min-height: 260px;
      height: 260px;
      padding: 18px 20px 0;
      background-size: contain;
      justify-content: flex-start;
      align-items: flex-start;
    }
    .splash::before {
      background: linear-gradient(
        180deg,
        transparent       0%,
        transparent       55%,
        rgba(10,10,12,.6) 78%,
        var(--bg)         100%
      );
    }
    /* Hide desktop overlay text on mobile */
    .desktop-only { display: none !important; }
    /* Show mobile text block */
    .hero-mobile  { display: flex; }
  }
</style>
