---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = `${base}assets/plc-icon-light.png`;
---

<div class="nav-wrap" id="nav-wrap">
  <div class="wrap">
    <nav>
      <a href="#" class="brand">
        <img src={logo} alt="PLC Group" />
        <div class="word">
          <b>PLC</b>
          <span>GROUP</span>
        </div>
      </a>

      <ul class="nlinks">
        <li><a href="#servizi">Servizi</a></li>
        <li><a href="#progetti">Progetti</a></li>
        <li><a href="#chi-siamo">Chi siamo</a></li>
        <li><a href="#contatti">Contatti</a></li>
      </ul>

      <div class="nav-right">
        <a class="phone" href="tel:+390600000000">☎ 06 000 0000</a>
        <a class="btn-base btn-cta btn-sm" href="#contatti">Prenota sopralluogo</a>
      </div>

      <!-- Mobile only: hamburger -->
      <button class="hamburger" id="hamburger" aria-label="Apri menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>

  <!-- Mobile menu overlay — child of sticky nav-wrap so it sticks with it -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <a href="#servizi"   class="menu-item" data-nav-link>Servizi   <span class="chevron">›</span></a>
    <a href="#progetti"  class="menu-item" data-nav-link>Progetti  <span class="chevron">›</span></a>
    <a href="#chi-siamo" class="menu-item" data-nav-link>Chi siamo <span class="chevron">›</span></a>
    <a href="#contatti"  class="menu-item" data-nav-link>Contatti  <span class="chevron">›</span></a>
    <a href="#contatti"  class="menu-cta"  data-nav-link>Prenota sopralluogo</a>
  </div>
</div>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background .3s, border-color .3s, backdrop-filter .3s;
  }
  .nav-wrap.scrolled {
    background: rgba(17, 20, 23, .88);
    border-color: var(--line-soft);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 16px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .brand img { height: 42px; width: auto; }
  .word      { font-family: var(--font-ui); line-height: 1; }
  .word b    { display: block; font-weight: 800; font-size: 21px; letter-spacing: 1px; color: var(--ink); }
  .word span { display: block; font-weight: 500; font-size: 10px; letter-spacing: 7px; color: var(--orange-bright); margin-top: 2px; }

  .nlinks {
    display: flex;
    gap: 24px;
    margin: 0 0 0 14px;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .nlinks a {
    position: relative;
    padding-bottom: 2px;
    transition: color var(--dur);
  }
  .nlinks a::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 1px;
    background: var(--orange);
    transition: width var(--dur);
  }
  .nlinks a:hover            { color: var(--ink); }
  .nlinks a:hover::after     { width: 100%; }

  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .phone {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 14px;
    color: var(--ink);
    transition: color var(--dur);
  }
  .phone:hover { color: var(--orange-bright); }

  /* ── Hamburger ── */
  .hamburger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    background: none;
    border: 1.5px solid var(--line);
    border-radius: 9px;
    cursor: pointer;
    padding: 0;
    margin-left: auto;
  }
  .hamburger span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform .2s ease, opacity .2s ease;
    transform-origin: center;
  }
  /* X state */
  .nav-wrap.menu-open .hamburger span:nth-child(1) { transform: rotate(45deg) translate(4.5px, 4.5px); }
  .nav-wrap.menu-open .hamburger span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav-wrap.menu-open .hamburger span:nth-child(3) { transform: rotate(-45deg) translate(4.5px, -4.5px); }

  /* ── Mobile menu ── */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--surface);
    border-bottom: 1.5px solid var(--line);
    overflow: hidden;
    max-height: 0;
    transition: max-height .28s cubic-bezier(.4,0,.2,1);
  }
  .nav-wrap.menu-open .mobile-menu {
    max-height: 400px;
  }
  .menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    transition: background var(--dur);
    text-decoration: none;
  }
  .menu-item:hover  { background: var(--surface-2); }
  .menu-item:last-of-type { border-bottom: none; }
  .chevron { color: var(--ink-faint); font-size: 17px; }
  .menu-cta {
    display: block;
    margin: 14px 16px 16px;
    padding: 14px;
    background: var(--orange);
    color: #160d04;
    border-radius: 8px;
    text-align: center;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: background var(--dur);
  }
  .menu-cta:hover { background: var(--orange-bright); }

  /* ── Responsive ── */
  @media (max-width: 880px) {
    .nlinks, .phone, .btn-sm  { display: none; }
    .hamburger                { display: flex; }
    .mobile-menu              { display: flex; }
    .nav-right                { display: none; }
  }
</style>

<script>
  const wrap     = document.getElementById('nav-wrap')!;
  const burger   = document.getElementById('hamburger')!;
  const navLinks = wrap.querySelectorAll('[data-nav-link]');

  /* sticky scroll tint */
  const tick = () => wrap.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', tick, { passive: true });
  tick();

  /* hamburger toggle */
  burger.addEventListener('click', () => {
    const open = wrap.classList.toggle('menu-open');
    burger.setAttribute('aria-expanded', String(open));
    wrap.querySelector('.mobile-menu')!.setAttribute('aria-hidden', String(!open));
  });

  /* close on any nav link click */
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      wrap.classList.remove('menu-open');
      burger.setAttribute('aria-expanded', 'false');
    });
  });
</script>
