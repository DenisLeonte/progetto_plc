---

<div class="wrap" id="servizi">
  <section>
    <div class="bento">

      <!-- Hero photo — desktop only, hidden on mobile (hero is in Splash on mobile) -->
      <div class="tile tile-hero">
        <div class="ph ph-fill"><span class="lbl">FOTO HERO — terrazzo impermeabilizzato</span></div>
        <div class="overlay">
          <p class="kicker">Impermeabilizzazioni · Roma &amp; Lazio</p>
          <h1 class="hand xl">Terrazzi a prova<br>d'acqua.</h1>
          <p class="sub">
            Interventi professionali con garanzia scritta 10 anni.
          </p>
          <div class="cta-row">
            <a class="btn-base btn-cta" href="#contatti">Prenota un sopralluogo</a>
            <a class="btn-base btn-ghost" href="#progetti">I lavori →</a>
          </div>
        </div>
      </div>

      <!-- Stat: anni — col 3 row 1 | mobile order 1 -->
      <div class="tile tile-stat tile-stat-anni">
        <span class="num">5+</span>
        <span class="cap">Anni di attività</span>
      </div>

      <!-- CTA tile — col 4 row 1 | mobile order 3 -->
      <a href="#contatti" class="tile tile-cta">
        <b>Sopralluogo gratuito</b>
        <span>PRENOTA ORA →</span>
      </a>

      <!-- Wide site photo — col 3-4 row 2 | mobile order 4 -->
      <div class="tile tile-wide">
        <div class="ph ph-fill"><span class="lbl">FOTO — cantiere / posa guaina</span></div>
      </div>

      <!-- Service 1 — col 3 row 3 | mobile order 5 -->
      <a href="#contatti" class="tile tile-svc">
        <div>
          <div class="svc-num">01</div>
          <h3 class="hand md">Impermeabilizzazione terrazzi</h3>
          <p class="svc-desc">Sistemi a freddo e a caldo, guaine liquide e bituminose</p>
        </div>
        <span class="arr">→</span>
      </a>

      <!-- Service 2 — col 4 row 3 | mobile order 6 -->
      <a href="#contatti" class="tile tile-svc">
        <div>
          <div class="svc-num">02</div>
          <h3 class="hand md">Posa di guaine</h3>
          <p class="svc-desc">Guaine ardesiata, poliurea, EPDM — su misura per ogni supporto</p>
        </div>
        <span class="arr">→</span>
      </a>

      <!-- Before / After slider — col 1-2 row 4 | mobile order 7 -->
      <div class="tile tile-ba">
        <div class="ba-slider" id="ba-slider">
          <div class="ba-after">
            <div class="ph ph-fill"><span class="lbl">DOPO</span></div>
          </div>
          <div class="ba-before" id="ba-before">
            <div class="ph ph-fill ph-wide"><span class="lbl">PRIMA</span></div>
          </div>
          <div class="ba-handle" id="ba-handle">
            <div class="ba-pill">⇔</div>
          </div>
          <span class="ba-label ba-left">Prima</span>
          <span class="ba-label ba-right">Dopo</span>
        </div>
      </div>

      <!-- Service 3 — col 3 row 4 | mobile order 8 -->
      <a href="#contatti" class="tile tile-svc tile-svc-3">
        <div>
          <div class="svc-num">03</div>
          <h3 class="hand md">Massetto + pavimento</h3>
          <p class="svc-desc">Rifacimento completo del piano, dall'isolamento alla finitura</p>
        </div>
        <span class="arr">→</span>
      </a>

      <!-- Stat: garanzia — col 4 row 4 | mobile order 2 -->
      <div class="tile tile-stat tile-stat-garanzia">
        <span class="num">10</span>
        <span class="cap">Anni di garanzia</span>
      </div>

    </div>
  </section>
</div>

<style>
  /* ── Desktop: 4-col bento ── */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(128px, auto);
    gap: 14px;
  }

  .tile {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    display: flex;
    text-decoration: none;
    color: var(--ink);
  }

  .ph-fill { position: absolute; inset: 0; border: none; border-radius: 0; }
  .ph-wide { min-width: 200%; }

  /* ── Hero (desktop only) ── */
  .tile-hero { grid-column: span 2; grid-row: span 3; }
  .overlay {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(180deg, rgba(20,19,18,.25), rgba(20,19,18,.92));
    display: flex; flex-direction: column;
    justify-content: flex-end;
    padding: 26px;
  }
  .overlay .hand   { color: #fff; margin: 10px 0 12px; }
  .overlay .kicker { color: var(--orange-bright); }
  .sub {
    font-family: var(--font-ui); font-size: 15px;
    color: rgba(255,255,255,.72);
    margin: 0 0 18px; max-width: 320px; line-height: 1.6;
  }
  .cta-row { display: flex; gap: 10px; flex-wrap: wrap; }

  /* ── Stat ── */
  .tile-stat {
    flex-direction: column; justify-content: center; align-items: center;
    text-align: center;
    background: var(--surface-2); border: 2px solid var(--line);
  }
  .tile-stat .num {
    font-family: var(--font-head); font-size: 38px;
    color: var(--orange-bright); line-height: 1;
  }
  .tile-stat .cap {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--ink-soft); margin-top: 6px;
  }

  /* ── CTA tile ── */
  .tile-cta {
    background: var(--orange); color: #160d04;
    flex-direction: column; justify-content: center; padding: 18px;
    transition: background var(--dur), box-shadow var(--dur), transform .18s;
  }
  .tile-cta:hover {
    background: var(--orange-bright);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(219,98,2,.35);
  }
  .tile-cta b    { font-family: var(--font-head); font-size: 24px; display: block; }
  .tile-cta span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; margin-top: 6px; display: block; }

  /* ── Wide photo ── */
  .tile-wide { grid-column: span 2; background: var(--surface); }

  /* ── Service ── */
  .tile-svc {
    padding: 18px; flex-direction: column;
    justify-content: space-between; align-items: flex-start;
    background: var(--surface); border: 2px solid var(--line);
    transition: background var(--dur), transform .18s;
  }
  .tile-svc:hover { background: var(--surface-2); transform: translateY(-2px); }
  .tile-svc:hover .arr { transform: translate(3px,-3px); color: var(--orange-bright); }
  .tile-svc .hand   { margin-top: 0; }

  .svc-num {
    font-family: var(--font-head); font-size: 52px;
    line-height: 1; color: var(--orange); opacity: .35;
    letter-spacing: -1px; margin-bottom: 6px;
  }
  .svc-desc {
    font-family: var(--font-mono); font-size: 11px;
    color: var(--ink-soft); margin-top: 5px;
    letter-spacing: .3px; line-height: 1.4; margin-bottom: 0;
  }

  .arr {
    font-family: var(--font-head); font-size: 26px;
    color: var(--orange-bright); align-self: flex-end;
    transition: transform .18s, color var(--dur);
    flex-shrink: 0;
  }

  /* ── Before/After ── */
  .tile-ba { grid-column: span 2; cursor: ew-resize; }
  .ba-slider { position: absolute; inset: 0; overflow: hidden; user-select: none; }
  .ba-after  { position: absolute; inset: 0; }
  .ba-before { position: absolute; inset: 0; width: 50%; overflow: hidden; border-right: 2px solid rgba(255,255,255,.8); }
  .ba-handle { position: absolute; top: 0; bottom: 0; left: 50%; transform: translateX(-50%); display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .ba-pill   { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.9); color:#222; display: flex; align-items: center; justify-content: center; font-size: 13px; box-shadow: 0 2px 12px rgba(0,0,0,.4); }
  .ba-label  { position: absolute; bottom: 10px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; padding: 4px 8px; border-radius: 5px; background: rgba(0,0,0,.55); color: rgba(255,255,255,.9); }
  .ba-left   { left: 10px; }
  .ba-right  { right: 10px; }

  /* ── Mobile: 2-col bento, no hero tile ── */
  @media (max-width: 880px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(100px, auto);
    }

    .tile-hero          { display: none; }

    .tile-stat-anni     { order: 1; min-height: 110px; }
    .tile-stat-garanzia { order: 2; min-height: 110px; }
    .tile-cta           { order: 3; min-height: 100px; }
    .tile-wide          { order: 4; min-height: 140px; grid-column: 1; }
    .tile-svc           { order: 5; padding: 16px 18px; }
    .tile-ba            { order: 7; min-height: 140px; grid-column: 1; }
    .tile-svc-3         { order: 8; }

    .tile-svc .hand     { font-size: 18px; letter-spacing: 0; line-height: 1.2; }
    .tile-svc .arr      { font-size: 22px; }
  }
</style>

<script>
  const slider = document.getElementById('ba-slider');
  const before = document.getElementById('ba-before');
  const handle = document.getElementById('ba-handle');
  if (slider && before && handle) {
    let active = false;
    const move = (x: number) => {
      const r   = slider.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, ((x - r.left) / r.width) * 100));
      before.style.width = pct + '%';
      handle.style.left  = pct + '%';
    };
    slider.addEventListener('mousedown',  e => { active = true; move(e.clientX); });
    slider.addEventListener('touchstart', e => { active = true; move(e.touches[0].clientX); }, { passive: true });
    window.addEventListener('mousemove',  e => { if (active) move(e.clientX); });
    window.addEventListener('touchmove',  e => { if (active) move(e.touches[0].clientX); }, { passive: true });
    window.addEventListener('mouseup',    () => { active = false; });
    window.addEventListener('touchend',   () => { active = false; });
  }
</script>
