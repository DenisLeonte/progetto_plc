---
const services = [
  { n: '01', title: 'Impermeabilizzazione', text: 'Terrazzi, balconi e lastrici protetti con sistemi continui e materiali certificati.' },
  { n: '02', title: 'Guaine tecniche', text: 'Posa a caldo e a freddo: bituminose, liquide, ardesiate, poliurea ed EPDM.' },
  { n: '03', title: 'Ripristino completo', text: 'Demolizione, massetto, isolamento e nuova pavimentazione, con un unico referente.' },
];

const projects = [
  { title: 'Terrazza residenziale', place: 'Roma · EUR', meta: '120 m² · impermeabilizzazione', img: 'https://images.unsplash.com/photo-1635424824849-1b09bdcc55b1?w=1200&h=900&q=85&auto=format&fit=crop' },
  { title: 'Lastrico solare', place: 'Frosinone', meta: '80 m² · guaina bituminosa', img: 'https://images.unsplash.com/photo-1518736346281-76873166a64a?w=1200&h=900&q=85&auto=format&fit=crop' },
  { title: 'Copertura condominiale', place: 'Latina', meta: '300 m² · ripristino completo', img: 'https://images.unsplash.com/photo-1635424709961-f3a150459ad4?w=1200&h=900&q=85&auto=format&fit=crop' },
];

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = `${base}assets/plc-icon-light.png`;
const map = `${base}assets/map-lazio.png`;
---

<header class="top" id="top">
  <a class="brand" href="#top" aria-label="PLC Group — Home">
    <img src={logo} alt="" />
    <span><b>PLC</b><small>GROUP</small></span>
  </a>
  <nav aria-label="Navigazione principale">
    <a href="#servizi">Servizi</a>
    <a href="#progetti">Progetti</a>
    <a href="#azienda">Azienda</a>
  </nav>
  <a class="nav-cta" href="#contatti">Parliamo del progetto <span>↗</span></a>
  <button class="menu" aria-label="Apri menu" aria-expanded="false"><span></span><span></span></button>
</header>

<main>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> Roma e tutto il Lazio</p>
      <h1>Costruiamo<br />superfici che<br /><em>durano.</em></h1>
      <div class="hero-bottom">
        <p>Impermeabilizzazione e ristrutturazione di terrazzi, balconi e coperture. Dalla diagnosi alla consegna, senza passaggi a vuoto.</p>
        <a class="button button-light" href="#contatti">Richiedi un sopralluogo <span>↗</span></a>
      </div>
    </div>
    <div class="hero-visual">
      <img src="https://images.unsplash.com/photo-1635424709961-f3a150459ad4?w=1600&h=1600&q=90&auto=format&fit=crop" alt="Professionisti al lavoro su una copertura" />
      <div class="hero-stamp"><strong>10</strong><span>anni di<br />garanzia</span></div>
      <p class="image-label">Sistemi certificati · posa professionale</p>
    </div>
  </section>

  <section class="trustbar" aria-label="Punti di forza">
    <p>Un unico partner, dall'analisi alla finitura.</p>
    <div><span>01</span> Sopralluogo gratuito</div>
    <div><span>02</span> Garanzia scritta</div>
    <div><span>03</span> Materiali certificati</div>
  </section>

  <section class="section services" id="servizi">
    <header class="section-head reveal">
      <p class="overline">Servizi / 01—03</p>
      <h2>Il lavoro fatto bene<br />inizia sotto la superficie.</h2>
      <p>Valutiamo il supporto, scegliamo il ciclo tecnico corretto e curiamo ogni strato. Perché il risultato si misura negli anni, non solo il giorno della consegna.</p>
    </header>
    <div class="service-list">
      {services.map((service) => (
        <article class="service reveal">
          <span class="service-no">{service.n}</span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
          <a href="#contatti" aria-label={`Richiedi informazioni su ${service.title}`}>↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="work" id="progetti">
    <div class="work-head reveal">
      <p class="overline">Lavori selezionati</p>
      <h2>Risultati che<br />parlano dal cantiere.</h2>
      <a href="#contatti">Hai un progetto simile? <span>↗</span></a>
    </div>
    <div class="project-grid">
      {projects.map((project, i) => (
        <article class={`project project-${i + 1} reveal`}>
          <div class="project-image"><img src={project.img} alt={project.title} loading={i ? 'lazy' : 'eager'} /></div>
          <div class="project-meta"><span>{project.place}</span><h3>{project.title}</h3><p>{project.meta}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="process section">
    <header class="process-title reveal">
      <p class="overline">Metodo PLC</p>
      <h2>Chiaro prima.<br />Preciso durante.<br />Solido dopo.</h2>
    </header>
    <ol class="steps">
      <li class="reveal"><span>01</span><div><h3>Sopralluogo</h3><p>Analizziamo supporto, infiltrazioni e criticità direttamente sul posto.</p></div></li>
      <li class="reveal"><span>02</span><div><h3>Soluzione tecnica</h3><p>Definiamo materiali, lavorazioni, tempi e un preventivo trasparente.</p></div></li>
      <li class="reveal"><span>03</span><div><h3>Esecuzione</h3><p>Coordiniamo il cantiere e documentiamo le fasi chiave dell'intervento.</p></div></li>
      <li class="reveal"><span>04</span><div><h3>Consegna garantita</h3><p>Collaudo finale, pulizia dell'area e garanzia scritta sul lavoro.</p></div></li>
    </ol>
  </section>

  <section class="about" id="azienda">
    <div class="about-copy reveal">
      <p class="overline">PLC Group / Roma</p>
      <h2>Competenza tecnica.<br />Responsabilità diretta.</h2>
      <p>Seguiamo ogni intervento con la stessa squadra, dal primo sopralluogo alla consegna. Un approccio concreto, costruito sul campo e pensato per privati, condomìni e imprese.</p>
      <div class="badges"><span>Garanzia 10 anni</span><span>RC professionale</span><span>DURC regolare</span></div>
    </div>
    <div class="coverage reveal">
      <img src={map} alt="Mappa dell'area operativa: Roma e Lazio" />
      <div><p>Area operativa</p><strong>Roma · Latina · Frosinone<br />Viterbo · Rieti</strong><span>Disponibili anche per trasferte</span></div>
    </div>
  </section>

  <section class="contact" id="contatti">
    <div class="contact-intro reveal">
      <p class="overline">Iniziamo da qui</p>
      <h2>Parliamo del tuo<br />prossimo lavoro.</h2>
      <p>Raccontaci cosa devi realizzare o ripristinare. Ti ricontattiamo per organizzare un sopralluogo gratuito.</p>
      <a href="mailto:info@plcgroup.it">info@plcgroup.it <span>↗</span></a>
    </div>
    <form class="contact-form reveal" id="contact-form">
      <label><span>Nome e cognome</span><input name="nome" autocomplete="name" required /></label>
      <label><span>Telefono</span><input name="telefono" type="tel" autocomplete="tel" required /></label>
      <label><span>Comune / zona</span><input name="zona" autocomplete="address-level2" required /></label>
      <label class="full"><span>Di cosa hai bisogno?</span><textarea name="messaggio" rows="3" required></textarea></label>
      <p class="privacy">Inviando accetti di essere ricontattato in merito alla richiesta.</p>
      <button class="button button-dark" type="submit">Invia la richiesta <span>↗</span></button>
      <p class="success" role="status">Grazie. La richiesta è pronta per essere presa in carico.</p>
    </form>
  </section>
</main>

<footer>
  <div class="footer-brand"><img src={logo} alt="" /><span><b>PLC</b><small>GROUP</small></span></div>
  <p>Impermeabilizzazioni e ristrutturazioni<br />a Roma e in tutto il Lazio.</p>
  <div class="footer-links"><a href="#servizi">Servizi</a><a href="#progetti">Progetti</a><a href="#azienda">Azienda</a><a href="#contatti">Contatti</a></div>
  <div class="footer-bottom"><span>© 2026 PLC Group</span><span>P.IVA 00000000000</span><a href="#top">Torna su ↑</a></div>
</footer>

<style>
  .top { height: 84px; padding: 0 clamp(22px,4vw,64px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; position: absolute; inset: 0 0 auto; z-index: 20; color: #fff; border-bottom: 1px solid rgba(255,255,255,.18); }
  .brand, .footer-brand { display: inline-flex; align-items: center; gap: 11px; width: max-content; }
  .brand img, .footer-brand img { width: 35px; height: 35px; object-fit: contain; }
  .brand span, .footer-brand span { display: flex; flex-direction: column; line-height: .9; }
  .brand b, .footer-brand b { font: 800 19px var(--font-display); letter-spacing: .05em; }
  .brand small, .footer-brand small { font: 600 8px var(--font-display); letter-spacing: .45em; color: var(--orange); margin-top: 5px; }
  .top nav { display: flex; gap: 34px; font-size: 13px; font-weight: 600; }
  .top nav a, .footer-links a { transition: opacity .2s; }
  .top nav a:hover, .footer-links a:hover { opacity: .58; }
  .nav-cta { justify-self: end; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 14px; }
  .nav-cta span { color: var(--orange); font-size: 18px; }
  .menu { display: none; border: 0; background: none; padding: 8px; }

  .hero { min-height: 760px; height: 100vh; max-height: 980px; display: grid; grid-template-columns: 57% 43%; background: var(--ink); color: #fff; }
  .hero-copy { padding: 150px clamp(30px,5.2vw,84px) 60px; display: flex; flex-direction: column; justify-content: space-between; background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px); background-size: 80px 80px; }
  .eyebrow, .overline { font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: rgba(255,255,255,.68); }
  .eyebrow span { width: 28px; height: 2px; background: var(--orange); }
  .hero h1 { margin: 28px 0 42px; font: 500 clamp(68px,7.1vw,122px)/.87 var(--font-display); letter-spacing: -.075em; }
  .hero h1 em { color: var(--orange); font-style: normal; }
  .hero-bottom { display: grid; grid-template-columns: minmax(220px,390px) auto; gap: 30px; align-items: end; }
  .hero-bottom p { margin: 0; color: rgba(255,255,255,.66); font-size: 15px; line-height: 1.7; }
  .button { min-height: 55px; padding: 0 21px; display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; border: 0; border-radius: var(--radius); font-weight: 700; font-size: 13px; cursor: pointer; transition: transform .2s var(--ease), background .2s; }
  .button:hover { transform: translateY(-2px); }
  .button span { font-size: 19px; }
  .button-light { background: var(--orange); color: #fff; white-space: nowrap; }
  .button-light:hover { background: #f06b13; }
  .hero-visual { position: relative; min-width: 0; overflow: hidden; }
  .hero-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg,rgba(23,25,22,.18),transparent 40%),linear-gradient(0deg,rgba(23,25,22,.5),transparent 45%); }
  .hero-visual > img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.68) contrast(1.05); }
  .hero-stamp { position: absolute; z-index: 2; top: 124px; right: 0; background: var(--orange); width: 176px; height: 112px; display: flex; align-items: center; justify-content: center; gap: 10px; }
  .hero-stamp strong { font: 600 54px/.8 var(--font-display); }
  .hero-stamp span { font-size: 11px; line-height: 1.3; text-transform: uppercase; letter-spacing: .09em; }
  .image-label { position: absolute; z-index: 2; bottom: 32px; left: 34px; margin: 0; font-size: 10px; letter-spacing: .15em; text-transform: uppercase; }

  .trustbar { min-height: 110px; display: grid; grid-template-columns: 1.55fr repeat(3,1fr); align-items: center; padding: 0 clamp(24px,5vw,80px); border-bottom: 1px solid var(--line); background: var(--white); }
  .trustbar p { font: 600 19px/1.3 var(--font-display); max-width: 300px; }
  .trustbar div { min-height: 110px; border-left: 1px solid var(--line); display: flex; align-items: center; padding-left: clamp(16px,2.5vw,38px); font-size: 12px; font-weight: 700; }
  .trustbar div span { color: var(--orange); margin-right: 12px; font-size: 10px; }

  .section { padding: clamp(90px,10vw,150px) clamp(24px,5vw,80px); }
  .section-head { display: grid; grid-template-columns: .55fr 1.45fr .8fr; gap: 40px; align-items: start; margin-bottom: 80px; }
  .overline { margin: 5px 0 0; color: var(--orange-dark); }
  .section h2, .work h2, .about h2, .contact h2 { margin: 0; font: 500 clamp(42px,5.1vw,76px)/.98 var(--font-display); letter-spacing: -.055em; }
  .section-head > p:last-child { color: var(--muted); line-height: 1.75; font-size: 15px; margin: 5px 0 0; }
  .service-list { border-top: 1px solid var(--line); }
  .service { min-height: 190px; display: grid; grid-template-columns: .55fr 1.2fr 1fr auto; gap: 40px; align-items: center; border-bottom: 1px solid var(--line); transition: background .3s, padding .3s var(--ease); }
  .service:hover { background: var(--white); padding: 0 22px; }
  .service-no { color: var(--orange); font-size: 11px; font-weight: 700; }
  .service h3 { font: 600 clamp(25px,2.6vw,38px)/1.1 var(--font-display); letter-spacing: -.035em; margin: 0; }
  .service p { color: var(--muted); line-height: 1.65; max-width: 410px; }
  .service > a { width: 48px; height: 48px; border: 1px solid var(--line); display: grid; place-items: center; font-size: 20px; transition: background .2s,color .2s; }
  .service > a:hover { background: var(--orange); color: #fff; }

  .work { background: var(--ink); color: #fff; padding: clamp(90px,10vw,150px) clamp(24px,5vw,80px); }
  .work-head { display: grid; grid-template-columns: .7fr 1.6fr .8fr; gap: 40px; align-items: end; margin-bottom: 72px; }
  .work-head .overline { align-self: start; color: var(--orange); }
  .work-head > a { justify-self: end; border-bottom: 1px solid rgba(255,255,255,.35); padding-bottom: 8px; font-size: 13px; font-weight: 700; }
  .work-head > a span { color: var(--orange); margin-left: 12px; }
  .project-grid { display: grid; grid-template-columns: 1.35fr .65fr; grid-template-rows: auto auto; gap: 42px 24px; }
  .project-1 { grid-row: 1 / span 2; }
  .project-image { overflow: hidden; background: #272a26; }
  .project-1 .project-image { aspect-ratio: 1.15; }
  .project-2 .project-image, .project-3 .project-image { aspect-ratio: 1.55; }
  .project-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.55); transition: transform .65s var(--ease), filter .65s; }
  .project:hover img { transform: scale(1.035); filter: saturate(.9); }
  .project-meta { display: grid; grid-template-columns: 1fr auto; gap: 4px 20px; padding-top: 16px; }
  .project-meta span { grid-column: 1/-1; color: var(--orange); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .project-meta h3 { font: 600 clamp(20px,2vw,29px) var(--font-display); letter-spacing: -.03em; margin: 4px 0 0; }
  .project-meta p { color: rgba(255,255,255,.48); margin: 11px 0 0; font-size: 11px; text-transform: uppercase; }

  .process { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(60px,10vw,160px); }
  .process-title { position: sticky; top: 50px; align-self: start; }
  .process-title .overline { margin-bottom: 30px; }
  .steps { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 64px 1fr; gap: 26px; padding: 34px 0; border-bottom: 1px solid var(--line); }
  .steps li > span { color: var(--orange); font-size: 10px; font-weight: 700; padding-top: 7px; }
  .steps h3 { font: 600 25px var(--font-display); letter-spacing: -.025em; margin: 0 0 8px; }
  .steps p { color: var(--muted); line-height: 1.65; max-width: 470px; margin: 0; }

  .about { display: grid; grid-template-columns: 1.05fr .95fr; background: var(--white); border-block: 1px solid var(--line); }
  .about-copy { padding: clamp(80px,9vw,140px) clamp(24px,6vw,95px); }
  .about-copy .overline { margin-bottom: 30px; }
  .about-copy > p:not(.overline) { max-width: 620px; color: var(--muted); font-size: 16px; line-height: 1.75; margin: 38px 0; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .badges span { border: 1px solid var(--line); padding: 10px 13px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; }
  .coverage { min-height: 600px; position: relative; background: var(--paper-2); overflow: hidden; }
  .coverage img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(.9); opacity: .67; }
  .coverage > div { position: absolute; inset: auto 30px 30px; background: var(--ink); color: #fff; padding: 25px; }
  .coverage p { color: var(--orange); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; margin: 0 0 12px; }
  .coverage strong { font: 600 20px/1.5 var(--font-display); }
  .coverage span { display: block; color: rgba(255,255,255,.45); margin-top: 10px; font-size: 12px; }

  .contact { padding: clamp(90px,10vw,150px) clamp(24px,5vw,80px); display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(60px,10vw,160px); background: var(--orange); color: #fff; }
  .contact .overline { color: rgba(255,255,255,.68); margin-bottom: 28px; }
  .contact-intro > p:not(.overline) { max-width: 480px; line-height: 1.7; color: rgba(255,255,255,.74); margin: 30px 0 55px; }
  .contact-intro > a { font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.45); padding-bottom: 8px; }
  .contact-intro > a span { margin-left: 14px; }
  .contact-form { display: grid; grid-template-columns: 1fr 1fr; gap: 30px 24px; align-content: start; }
  .contact-form label { display: flex; flex-direction: column; gap: 9px; }
  .contact-form label span { font-size: 10px; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; }
  .contact-form input, .contact-form textarea { border: 0; border-bottom: 1px solid rgba(255,255,255,.55); border-radius: 0; background: transparent; color: #fff; padding: 8px 0 14px; outline: 0; }
  .contact-form input:focus, .contact-form textarea:focus { border-color: #fff; }
  .contact-form .full { grid-column: 1/-1; }
  .privacy { color: rgba(255,255,255,.62); font-size: 10px; line-height: 1.5; margin: 0; align-self: center; }
  .button-dark { background: var(--ink); color: #fff; min-width: 230px; justify-self: end; }
  .success { display: none; grid-column: 1/-1; margin: 0; font-weight: 700; }

  footer { background: var(--ink); color: #fff; padding: 70px clamp(24px,5vw,80px) 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 35px; }
  .footer-brand img { filter: none; }
  footer > p { justify-self: end; color: rgba(255,255,255,.5); line-height: 1.6; margin: 0; }
  .footer-links { grid-column: 1/-1; display: flex; flex-wrap: wrap; gap: 28px; padding: 50px 0; border-bottom: 1px solid rgba(255,255,255,.13); font: 500 clamp(28px,4vw,62px) var(--font-display); letter-spacing: -.045em; }
  .footer-links a:not(:last-child)::after { content: ' /'; color: var(--orange); }
  .footer-bottom { grid-column: 1/-1; display: grid; grid-template-columns: 1fr 1fr auto; color: rgba(255,255,255,.42); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
  .footer-bottom a { color: #fff; }

  @media (max-width: 980px) {
    .top { grid-template-columns: 1fr auto; height: 72px; }
    .top nav, .nav-cta { display: none; }
    .menu { display: flex; flex-direction: column; gap: 6px; }
    .menu span { width: 24px; height: 1px; background: #fff; }
    .top.open nav { display: flex; position: absolute; top: 72px; left: 0; right: 0; background: var(--ink); padding: 30px; flex-direction: column; font-size: 22px; border-top: 1px solid rgba(255,255,255,.15); }
    .hero { min-height: 900px; height: auto; grid-template-columns: 1fr; }
    .hero-copy { min-height: 620px; padding-top: 130px; }
    .hero-visual { min-height: 450px; }
    .trustbar { grid-template-columns: 1fr 1fr; }
    .trustbar p { grid-column: 1/-1; max-width: none; padding: 25px 0; border-bottom: 1px solid var(--line); }
    .trustbar div { border-left: 0; border-right: 1px solid var(--line); }
    .section-head, .work-head { grid-template-columns: 1fr 2fr; }
    .section-head > p:last-child, .work-head > a { grid-column: 2; justify-self: start; }
    .process, .contact { grid-template-columns: 1fr; }
    .process-title { position: static; }
    .about { grid-template-columns: 1fr; }
    .coverage { min-height: 450px; }
  }

  @media (max-width: 640px) {
    .hero-copy { min-height: 570px; padding: 110px 22px 38px; }
    .hero h1 { font-size: clamp(56px,18vw,82px); margin: 16px 0 34px; }
    .hero-bottom { grid-template-columns: 1fr; gap: 24px; }
    .button-light { width: 100%; }
    .hero-visual { min-height: 390px; }
    .hero-stamp { top: 0; width: 145px; height: 92px; }
    .hero-stamp strong { font-size: 44px; }
    .trustbar { grid-template-columns: 1fr; padding: 0 22px; }
    .trustbar div { border-right: 0; border-bottom: 1px solid var(--line); min-height: 75px; padding: 0; }
    .section-head, .work-head { grid-template-columns: 1fr; gap: 24px; margin-bottom: 50px; }
    .section-head > p:last-child, .work-head > a { grid-column: 1; }
    .service { grid-template-columns: 40px 1fr auto; gap: 14px; padding: 26px 0; }
    .service:hover { padding: 26px 10px; }
    .service p { grid-column: 2/-1; margin: 0; }
    .service > a { width: 40px; height: 40px; }
    .project-grid { grid-template-columns: 1fr; gap: 42px; }
    .project-1 { grid-row: auto; }
    .project-1 .project-image, .project-2 .project-image, .project-3 .project-image { aspect-ratio: 1.2; }
    .project-meta { grid-template-columns: 1fr; }
    .project-meta p { margin-top: 2px; }
    .about-copy { padding-inline: 24px; }
    .contact-form { grid-template-columns: 1fr; }
    .contact-form .full { grid-column: 1; }
    .button-dark { width: 100%; justify-self: stretch; }
    .success { grid-column: 1; }
    footer { grid-template-columns: 1fr; }
    footer > p { justify-self: start; }
    .footer-links { font-size: 30px; padding: 30px 0; gap: 13px; }
    .footer-bottom { grid-template-columns: 1fr; gap: 10px; }
  }
</style>

<script>
  const top = document.querySelector<HTMLElement>('.top');
  const menu = document.querySelector<HTMLButtonElement>('.menu');
  menu?.addEventListener('click', () => {
    const open = top?.classList.toggle('open') ?? false;
    menu.setAttribute('aria-expanded', String(open));
  });
  top?.querySelectorAll('nav a').forEach(link => link.addEventListener('click', () => {
    top.classList.remove('open');
    menu?.setAttribute('aria-expanded', 'false');
  }));

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', event => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    form.querySelector<HTMLElement>('.success')!.style.display = 'block';
    form.reset();
  });
</script>
