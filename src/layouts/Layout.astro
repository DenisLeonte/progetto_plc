---
import TweaksPanel from '../components/TweaksPanel.jsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PLC Group — Impermeabilizzazioni & Ristrutturazioni · Roma e Lazio',
  description = 'Impermeabilizzazione terrazzi, posa guaine e ristrutturazioni nel Lazio. Preventivo gratuito in 24 ore.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logoLight = `${base}assets/plc-icon-light.png`;
const logoDark  = `${base}assets/plc-icon-dark.png`;
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href={logoLight} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Kalam:wght@300;400;700&family=Caveat:wght@500;700&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="mood-asfalto char-geometrico acc-medio">
  <!-- Pass logo URLs to React via data attrs so the island can swap them -->
  <span id="logo-urls" data-light={logoLight} data-dark={logoDark} style="display:none"></span>

  <slot />

  <TweaksPanel client:only="react" logoLight={logoLight} logoDark={logoDark} />
</body>
</html>

<style is:global>
  /* ── Design tokens ── */
  :root {
    --bg: #141312;
    --bg-2: #1b1916;
    --surface: #1f1c19;
    --surface-2: #262320;
    --line: #36322b;
    --line-soft: #2a2722;
    --ink: #f2efe9;
    --ink-soft: #a8a299;
    --ink-faint: #6f6a61;
    --orange: #db6202;
    --orange-bright: #f07d24;
    --orange-deep: #b5500a;
    --font-head: 'Patrick Hand', cursive;
    --font-body: 'Kalam', cursive;
    --font-note: 'Caveat', cursive;
    --font-ui: 'Archivo', system-ui, sans-serif;
    --font-mono: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --ph-a: #211e1b; --ph-b: #272320;
    --ph-label-bg: rgba(13,12,11,.72); --ph-label-ink: #9b958b;
    --lines-color: #312d27;
    --footer-bg: #0e0d0c;
    --dot: rgba(255,255,255,.035);
    --logo-neutral: #eef1ec;
    --dur: .22s;
  }

  /* ── Mood: Asfalto ── */
  body.mood-asfalto {
    --bg:#111417;--bg-2:#161b1f;--surface:#1a2025;--surface-2:#212931;
    --line:#2d363d;--line-soft:#222a30;--ink:#eef2f4;--ink-soft:#9aa6ad;--ink-faint:#646f76;
    --ph-a:#1a2025;--ph-b:#202830;--lines-color:#28313a;--footer-bg:#0c0f12;
  }
  /* ── Mood: Cemento ── */
  body.mood-cemento {
    --bg:#e7e3dc;--bg-2:#efece6;--surface:#fbfaf7;--surface-2:#f1eee8;
    --line:#cdc6bb;--line-soft:#d9d3c9;--ink:#221f1a;--ink-soft:#6a655c;--ink-faint:#9b958a;
    --ph-a:#ddd8cf;--ph-b:#e7e2d9;--ph-label-bg:rgba(255,255,255,.8);--ph-label-ink:#8a847a;
    --lines-color:#d3ccc1;--footer-bg:#e1ddd5;--dot:rgba(0,0,0,.05);--logo-neutral:#201d18;
  }

  /* ── Carattere ── */
  body.char-industriale { --font-head:'Oswald',sans-serif; --font-body:'Archivo',sans-serif; }
  body.char-industriale .hand { text-transform:uppercase; letter-spacing:.6px; font-weight:600; line-height:1.07; }
  body.char-industriale .hand.xl { letter-spacing:0; }
  body.char-geometrico  { --font-head:'Archivo',sans-serif; --font-body:'Archivo',sans-serif; }
  body.char-geometrico  .hand { font-weight:800; letter-spacing:-.6px; }

  /* ── Energia ── */
  body.acc-sobrio .tile-stat .num { color:var(--ink); }
  body.acc-sobrio .kicker          { color:var(--ink-soft); }
  body.acc-sobrio .tile-cta        { background:var(--surface-2); color:var(--ink); }
  body.acc-sobrio .tile-cta b      { color:var(--ink); }
  body.acc-sobrio .tile-cta span   { color:var(--orange-bright); }
  body.acc-sobrio .tile-svc .arr   { color:var(--ink-soft); }
  body.acc-sobrio .chip.on         { border-color:var(--ink-soft); color:var(--ink); }
  body.acc-acceso                  { --dot:rgba(240,125,36,.06); }
  body.acc-acceso .btn-cta         { box-shadow:0 0 24px rgba(219,98,2,.45); }
  body.acc-acceso .tile-cta        { box-shadow:0 0 42px rgba(219,98,2,.42),inset 0 0 0 1px rgba(255,255,255,.12); }
  body.acc-acceso .kicker          { text-shadow:0 0 16px rgba(240,125,36,.55); }
  body.acc-acceso .tile-stat .num  { text-shadow:0 0 22px rgba(240,125,36,.6); }
  body.acc-acceso .tile-stat       { border-color:var(--orange-deep); }
  body.acc-acceso .chip.on         { background:var(--orange); border-color:var(--orange); color:#160d04; }

  /* ── Reset & base ── */
  *, *::before, *::after { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  html, body { margin:0; padding:0; }
  body {
    font-family:var(--font-body);
    background:var(--bg);
    color:var(--ink);
    background-image:radial-gradient(var(--dot) 0.6px, transparent 0.6px);
    background-size:24px 24px;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img  { display:block; max-width:100%; }
  a    { color:inherit; text-decoration:none; }

  /* ── Layout ── */
  .wrap { max-width:1200px; margin:0 auto; padding:0 28px; }
  section { padding:52px 0; }

  /* ── Typography ── */
  .kicker {
    font-family:var(--font-mono); font-size:11px; letter-spacing:3px;
    text-transform:uppercase; color:var(--orange-bright);
  }
  .hand { font-family:var(--font-head); line-height:1.04; margin:0; color:var(--ink); }
  .hand.xl  { font-size:50px; }
  .hand.lg  { font-size:33px; }
  .hand.md  { font-size:23px; }

  /* ── Buttons ── */
  .btn-base {
    display:inline-flex; align-items:center; gap:8px;
    font-family:var(--font-head); font-size:17px;
    border:2px solid var(--line); background:transparent; color:var(--ink);
    padding:10px 19px; border-radius:11px; cursor:pointer;
    transition:border-color var(--dur),background var(--dur),box-shadow var(--dur),color var(--dur);
    text-decoration:none;
  }
  .btn-base:hover { border-color:var(--ink-soft); }
  .btn-cta {
    background:var(--orange); border-color:var(--orange);
    color:#160d04; font-weight:400;
  }
  .btn-cta:hover {
    background:var(--orange-bright); border-color:var(--orange-bright);
    box-shadow:0 8px 26px rgba(219,98,2,.32);
  }
  .btn-ghost { border-color:var(--line); color:var(--ink-soft); }
  .btn-ghost:hover { border-color:var(--ink-faint); color:var(--ink); }
  .btn-sm { font-size:15px; padding:8px 15px; }

  /* ── Chips ── */
  .chip {
    display:inline-flex; align-items:center; gap:6px;
    font-family:var(--font-mono); font-size:11px; letter-spacing:1px; text-transform:uppercase;
    border:1.5px solid var(--line); border-radius:30px; padding:5px 12px; color:var(--ink-soft);
    cursor:pointer;
    transition:border-color var(--dur),color var(--dur),background var(--dur);
  }
  .chip:hover { border-color:var(--ink-faint); color:var(--ink); }
  .chip.on    { border-color:var(--orange); color:var(--orange-bright); }

  /* ── Card ── */
  .card { background:var(--surface); border:2px solid var(--line); border-radius:16px; }

  /* ── Placeholders ── */
  .ph {
    position:relative;
    background:repeating-linear-gradient(45deg,var(--ph-a),var(--ph-a) 9px,var(--ph-b) 9px,var(--ph-b) 18px);
    border:2px solid var(--line); border-radius:12px;
    display:flex; align-items:center; justify-content:center;
    text-align:center; overflow:hidden; color:var(--ink-faint);
  }
  .ph .lbl {
    font-family:var(--font-mono); font-size:11px; letter-spacing:.5px;
    color:var(--ph-label-ink); background:var(--ph-label-bg);
    padding:5px 10px; border-radius:6px;
  }

  /* ── Scroll-reveal ── */
  .reveal {
    opacity:0; transform:translateY(22px);
    transition:opacity .55s ease,transform .55s ease;
  }
  .reveal.in      { opacity:1; transform:none; }
  .reveal.delay-1 { transition-delay:.08s; }
  .reveal.delay-2 { transition-delay:.16s; }
  .reveal.delay-3 { transition-delay:.24s; }
  @media (prefers-reduced-motion:reduce) {
    .reveal { opacity:1; transform:none; }
  }

  /* ── Responsive ── */
  @media (max-width:880px) {
    .hand.xl { font-size:36px; }
    .hand.lg { font-size:26px; }
  }
  @media (max-width:540px) {
    .wrap { padding:0 16px; }
  }
</style>

<script>
  /* Scroll-reveal observer — runs once for the whole page */
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
